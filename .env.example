# Database
DATABASE_URL=postgresql://user:password@host:5432/clubd?sslmode=require

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here

# Twilio Verify (Phone OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret-jwt
APPLE_BUNDLE_ID=your-apple-bundle-id

# Demo Login (set to "true" to enable demo login during beta)
DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Public URLs
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
